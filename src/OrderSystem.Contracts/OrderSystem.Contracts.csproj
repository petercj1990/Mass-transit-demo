<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Message contracts only. Note that this project has NO reference to MassTransit:
    messages are plain records, so any service (or a different messaging library)
    can share them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
